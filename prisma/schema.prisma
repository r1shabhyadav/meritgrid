generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  name            String?
  role            String    @default("learner") // learner, employer
  avatar          String?
  createdAt       DateTime  @default(now())
  
  // Learner specific fields
  hireabilityIndex Int?     @default(1000)
  location        String?
  projects        Project[]
  skills          Skill[]
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  score       Int?
  feedback    String?
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}

model Skill {
  id          Int      @id @default(autoincrement())
  name        String
  proficiency String   // Developing, Proficient, Mastered
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
}
